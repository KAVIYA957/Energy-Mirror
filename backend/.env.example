# Energy Mirror Backend Environment Configuration Example
# Copy this file to .env and configure appropriate values.
# CRITICAL: DO NOT commit real .env files, secrets, or tokens to source control.

# Runtime Environment mode: 'development', 'testing', or 'production'
# In 'production', debug must be false, wildcards in CORS are rejected, and ADMIN_API_KEY must be >= 16 chars.
ENVIRONMENT=development

# Debug flag (Must be false in production)
DEBUG=true

# Database Connection URL
# Default (Local Development & Demo): SQLite
# SQLite: DATABASE_URL=sqlite:///./energy_mirror.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/energy_mirror
# Note: Both postgresql:// and legacy postgres:// URLs are automatically normalized to use psycopg2.
DATABASE_URL=sqlite:///./energy_mirror.db

# CORS Allowed Origins (Comma-separated list)
# In development, defaults to localhost:5000, localhost:8000, localhost:3000
# In production, wildcards (*) are strictly forbidden and at least one explicit domain is mandatory.
# Example: CORS_ORIGINS=https://energymirror.example.com,https://demo.energymirror.example.com
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Administrative API Key
# Protects appliance registry mutations (POST, PATCH, DELETE /api/v1/appliances).
# In development: If left blank, administrative mutations are restricted to local loopback (localhost/testclient).
# In production: Must be set to a cryptographically strong secret (>= 16 characters).
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Ingestion Security Token
# Protects physical telemetry ingestion endpoint (POST /api/v1/telemetry/ingest via X-Device-Token).
# Evaluated using constant-time comparison to prevent timing attacks.
DEVICE_INGEST_TOKEN=

# Mode toggle: When false (default), hardware ingestion is staged/inactive and virtual simulator remains active.
# In accordance with project safety constraints, keep ENABLE_HARDWARE_INGEST=false.
ENABLE_HARDWARE_INGEST=false
