# Energy Mirror Backend Environment Configuration Example
# Copy this file to .env and configure real values. DO NOT commit .env to source control.

DEBUG=true
DATABASE_URL=sqlite:///./energy_mirror.db

# Ingestion Security
# When hardware is deployed, set DEVICE_INGEST_TOKEN to a cryptographically strong random string.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_INGEST_TOKEN=replace_with_secure_random_token_when_hardware_is_deployed

# Mode toggle: When false, hardware ingestion is staged/inactive and simulator remains active default.
ENABLE_HARDWARE_INGEST=false
