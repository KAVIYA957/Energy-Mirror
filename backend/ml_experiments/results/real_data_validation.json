    "three_question_framework": {
      "question_1": {
        "question": "Can the meter measure aggregate power accurately?",
        "verdict": "YES",
        "evidence": "High-precision metrology ICs (e.g. ADE7953, BL0942, Schneider EM6400) comply with IEC 62053-21 Class 1.0 accuracy (error <= 1.0% down to 0.05 I_b). The meter reliably measures aggregate residential power across the entire dynamic range (10 W to 10 kW)."
      },
      "question_2": {
        "question": "Can the system detect a change of approximately 12 W from aggregate measurements?",
        "verdict": "CONDITIONALLY IN CLEAN LAB / NO ON REAL RESIDENTIAL MAINS",
        "evidence": "In an isolated, noise-free laboratory circuit, a 12 W step is readily detectable. However, on genuine residential mains, the 6-second delta-power standard deviation is 112.66 W, with a 95th percentile background step of 27.72 W. The resulting SNR is 0.107 (< 1.0). Furthermore, mains voltage varies with std = 11.93 V; an ordinary 1 V voltage drop on a 1.2 kW household load produces a 11.4 W step (P proportional to V^2), completely submerging any 12 W switching signature."
      },
      "question_3": {
        "question": "Can the system uniquely attribute that 12 W change to an LED bulb?",
        "verdict": "NO (ACTIVE POWER IS ILL-POSED FOR ATTRIBUTION)",
        "evidence": "Even if an algorithm isolated a true 12 W active step, active power alone cannot uniquely attribute it to an LED bulb. Dozens of common consumer electronics\u2014including laptop chargers shifting between trickle and float modes, TV display brightness changes, Wi-Fi routers modulating transmission power, and smart appliances in standby\u2014produce identical 8 to 15 W transitions. Disaggregation without high-frequency current harmonics or localized circuit submetering is mathematically ambiguous."
      }
    },
    "proposed_future_validation_protocol": {
      "objective": "Determine whether harmonic current signatures can resolve the 12 W LED attribution problem.",
      "hardware_requirements": [
        "High-bandwidth current transformer or Rogowski coil with flat response up to 2.5 kHz.",
        "Simultaneous aggregate voltage and current waveform capture at >= 8 kHz sampling frequency.",
        "Harmonic decomposition engine calculating total harmonic distortion (THD_i) and odd harmonics (3rd, 5th, 7th).",
        "Synchronized plug-level smart metering (e.g. Shelly Plus 1PM or Tuya power meter) for ground truth."
      ],
      "hypothesis": "LED drivers use bridge rectifiers with high current harmonic distortion (THD_i > 80%), yielding distinctive 3rd and 5th harmonic current phase shifts that distinguish lighting from resistive heating or active-PFC switch-mode electronics."
    }
  },
