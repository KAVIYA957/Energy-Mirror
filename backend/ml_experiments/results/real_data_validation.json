  "pipeline_improvement": {
    "technique": "Noise-Aware Dynamic Thresholding with Duration Hysteresis & Plateau Verification",
    "rationale": "Naive differential edge detectors fail in real homes because multi-appliance baseline fluctuations and voltage swings trigger massive false positives. The improved detector scales the step threshold by local noise standard deviation (theta_dyn = theta_0 + k*sigma_local) and enforces duration hysteresis (power must remain elevated for >= 12s).",
    "tuned_hyperparameters": {
      "base_step": 250.0,
      "k_noise": 1.0,
      "min_hold": 3
    },
    "validation_event_f1": 0.1538,
